{
  "cache_stats_enabled": true,
  "cache_stats_dir": "cache_stats",
  "cache_stats_retention_days": 30,
  "stream_timeout": 600,
  "services": [
    {
      "comment": "示例：阿里云 DashScope（claude 转换）",
      "mode": "claude",
      "model": "qwen-plus",
      "sub_model": "qwen-plus",
      "listen_address": "11011",
      "openai_base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions",
      "openai_api_key": "sk-your-api-key-here"
    },
    {
      "comment": "示例：Anthropic 直连透传（direct）",
      "mode": "direct",
      "model": "claude-4",
      "listen_address": "11013",
      "openai_base_url": "https://api.anthropic.com/v1/messages",
      "openai_api_key": "sk-ant-your-anthropic-key"
    }
  ]
}
